# Copiar a app/.env y completar con tu cuenta Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
# Usar una contraseña de aplicación de Google, sin espacios; no una API key.
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM_NAME=EcoHarmony Park
SMTP_TIMEOUT=10
# Opcional. Si se omite, se genera una clave temporal al iniciar la app.
# Configurar una clave aleatoria en app/.env para conservar sesiones entre reinicios.
SESSION_SECRET_KEY=
